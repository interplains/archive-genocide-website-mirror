# The data + media come from the signed torrent, NOT from git (too large + change often).
/data/*
/media/*
!/data/.gitkeep
!/media/.gitkeep
!/data/victims.json

# Never commit signing SECRET keys or any credentials.
*.key
*.sec
minisign.key
*secret*
*.pem
.env

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
__pycache__/
*.pyc

# local rollback snapshots (never commit)
_rollback_mirror_*/

# Local safety copies taken before edits. Never distribute these: this is the PUBLIC mirror, and
# a stale .bak of a verification script sitting beside the real one invites someone to run the
# wrong file. Git history is the real backup.
*.bak_*
*.bak
